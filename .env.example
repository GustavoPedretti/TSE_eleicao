# Copie para .env (não versionar)

ELEICAO_ATIVA=6258
POLL_INTERVAL_SEGUNDOS=60

# Local: 1 | Vercel: a plataforma seta VERCEL=1 e o default vira 0
RUN_LOCAL_POLLER=1

# Mesmo valor na Vercel como CRON_SECRET (a plataforma manda Bearer automático)
POLL_SECRET=troque-por-uma-string-longa
CRON_SECRET=troque-por-uma-string-longa

# Supabase → Project Settings → Database → Connection string (URI)
# Ex.: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
